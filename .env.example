# Python control-plane configuration. Copy to .env and fill values locally.
PA_LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# System-1 judge uses TypeSafe Jev; logged DeepSeek fallback needs its key above.
TYPESAFE_API_KEY=
# DSH Workers also read ~/.dsh/.credentials.yaml; configure providers separately.
